rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && myRole() == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && myRole() == 'student';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && request.auth.uid == studentId);
      allow write: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }

    match /departments/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /courses/{id}     { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /divisions/{id}   { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /subjects/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }

    match /attendance/{id} {
      allow read: if isAdmin() || isTeacher() || isStudent();
      allow write: if isAdmin() || isTeacher();
    }

    match /marks/{id} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin() || isTeacher();
    }

    match /assignments/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /submissions/{id} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.studentId == request.auth.uid);
    }

    match /studyMaterials/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /notices/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /academicYears/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /semesters/{id}     { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /settings/{id}      { allow read: if isSignedIn(); allow write: if isAdmin(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}