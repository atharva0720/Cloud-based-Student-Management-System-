rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Study materials: teachers/admin upload, any signed-in user reads.
    match /studyMaterials/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024 // 25MB max
        && request.resource.contentType.matches('application/pdf|application/.*word.*|application/.*presentation.*|image/.*');
    }

    // Assignment submissions: a student may only write to their own
    // folder, named by their own uid.
    match /submissions/{studentId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
